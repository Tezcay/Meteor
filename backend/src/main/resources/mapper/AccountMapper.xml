<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dev.meteor.auth.mapper.AccountMapper">

    <select id="findByEmail" resultType="dev.meteor.auth.mapper.projection.AccountCredentialsProjection">
        SELECT id,
               email,
               password_hash AS passwordHash,
               display_name AS displayName,
               status
        FROM users
        WHERE email = #{email}
        LIMIT 1
    </select>

    <select id="findRolesByUserId" resultType="java.lang.String">
        SELECT role
        FROM user_roles
        WHERE user_id = #{userId}
        ORDER BY role
    </select>
</mapper>
